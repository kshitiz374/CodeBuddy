# CodeBuddy configuration
# Copy to .env and adjust as needed.

# AI provider: "ollama" for local inference, "mock" for offline/demo/tests
AI_PROVIDER=ollama

# Ollama HTTP endpoint (local-first default)
OLLAMA_BASE_URL=http://localhost:11434

# Open-weight model name (pull with: ollama pull <MODEL_NAME>)
# Options: qwen2.5-coder:7b, llama3.1:8b, phi3, mistral, etc.
MODEL_NAME=qwen2.5-coder:7b

# Request timeout for AI calls (seconds)
AI_TIMEOUT_SECONDS=180

# SQLite database path (relative to apps/api or absolute)
DATABASE_URL=sqlite:///./data/codebuddy.db

# CORS origins for the Next.js dev server
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API port
API_PORT=8000